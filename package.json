{
  "name": "pimpao-bot-vk",
  "version": "2.0.0",
  "private": true,
  "description": "Bot serverless para tópicos de discussão da comunidade Botafogo no VK",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch --import tsx src/dev-server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "campeonato-brasileiro-api": "^2.0.1",
    "mongoose": "^9.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.8.0",
    "prettier": "^3.9.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.12"
  }
}
